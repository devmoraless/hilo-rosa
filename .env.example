# Copy to .env (git-ignored). Every key is optional: without them the demo uses local fallbacks.
# Telegram bot for the result notice and the OTP (fallback: LogNotifier, "SMS simulado" on screen)
TELEGRAM_BOT_TOKEN=
TELEGRAM_DEMO_CHAT_ID=
# Valkey/Redis for OTPs and sessions with TTL (fallback: in-memory dict with expiry)
VALKEY_URL=
# Claude, optional (P2): softer wording of the plain-language text (fallback: fixed templates)
ANTHROPIC_API_KEY=
# Public URL printed in the QR credential
HILO_PUBLIC_URL=http://localhost:8000
